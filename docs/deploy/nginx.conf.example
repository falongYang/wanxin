# nginx HTTPS reverse proxy for 晚信. Replace placeholders before use.
# Certificates and the PUBLIC_ORIGIN must be approved by the owner first.

server {
    listen 443 ssl http2;
    server_name _; # TODO: your-domain

    ssl_certificate     /etc/letsencrypt/live/<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<domain>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # PUBLIC_ORIGIN must be https://<domain> and match the browser Origin exactly.
    # Static frontend (Vite dist): root /var/www/ant-epoch, path /wanxin/.
    root /var/www/ant-epoch;

    location = /wanxin/ {
        try_files $uri /wanxin/index.html;
    }
    location /wanxin/ {
        try_files $uri $uri/ /wanxin/index.html;
    }

    # API reverse proxy to the Node service bound on 127.0.0.1:3001.
    # Do NOT inject X-Forwarded-For unless single-proxy mode is explicitly
    # approved AND this is the unique trusted proxy (the app validates socket IP).
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
}

# Optional: redirect HTTP to HTTPS
server {
    listen 80;
    server_name wan.example;
    return 301 https://$host$request_uri;
}